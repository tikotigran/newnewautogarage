{
  "entities": {
    "Vehicle": {
      "title": "Vehicle",
      "description": "Represents a vehicle purchased, prepared, repaired, and sold by an auto garage or independent dealer.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique ID of the vehicle" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "garageId": { "type": "string", "maxLength": 128, "description": "Scoped garage workspace ID" },
        "make": { "type": "string", "maxLength": 80, "description": "Vehicle brand / manufacturer (e.g. Peugeot, Renault)" },
        "model": { "type": "string", "maxLength": 80, "description": "Vehicle model (e.g. 208, Clio)" },
        "trim": { "type": "string", "maxLength": 80, "description": "Trim / Version / Finition (e.g. GT Line, Allure)" },
        "year": { "type": "number", "description": "Model year (e.g. 2021)" },
        "mileage": { "type": "number", "description": "Mileage in kilometers" },
        "vin": { "type": "string", "maxLength": 30, "description": "Vehicle Identification Number (E)" },
        "registrationNumber": { "type": "string", "maxLength": 30, "description": "Vehicle registration plate / Immatriculation (e.g. AB-123-CD)" },
        "fuelType": { "type": "string", "maxLength": 60, "description": "Fuel type" },
        "gearbox": { "type": "string", "maxLength": 60, "description": "Transmission / gearbox type" },
        "typeVariantVersion": { "type": "string", "maxLength": 80, "description": "Carte Grise D.2 type/variant/version" },
        "nationalGenre": { "type": "string", "maxLength": 30, "description": "Carte Grise J.1 national genre" },
        "bodyType": { "type": "string", "maxLength": 30, "description": "Carte Grise J.3 body type" },
        "formulaNumber": { "type": "string", "maxLength": 60, "description": "Carte Grise formula number" },
        "certificateDate": { "type": "string", "maxLength": 30, "description": "Carte Grise issue date (I)" },
        "purchaseDate": { "type": "string", "description": "Date of acquisition (YYYY-MM-DD)" },
        "purchasePrice": { "type": "number", "description": "Purchase cost in Euros" },
        "targetSalePrice": { "type": "number", "description": "Target or listed sales price in Euros" },
        "status": {
          "type": "string",
          "enum": ["preparation", "repair", "for_sale", "sold"],
          "description": "Current lifecycle status"
        },
        "purchaseStatus": {
          "type": "string",
          "enum": ["micro", "particulier"],
          "description": "Purchase owner status (Micro-entrepreneur business vs Particulier private individual) used to pre-select Cerfa 15776*02 seller data"
        },
        "photos": { "type": "array", "description": "List of photo URLs or base64 data" },
        "documents": { "type": "array", "description": "List of attached document metadata and URLs" },
        "buyerInfo": { "type": "object", "description": "Buyer details recorded upon sale" },
        "repairCostTotal": { "type": "number", "description": "Aggregated sum of all parts and labor costs" },
        "generalExpensesTotal": { "type": "number", "description": "Aggregated sum of all general non-repair expenses" },
        "totalExpenses": { "type": "number", "description": "Repair total + General expenses total" },
        "totalInvested": { "type": "number", "description": "Purchase price + total expenses" },
        "netProfit": { "type": "number", "description": "Final or projected sale price minus total invested" },
        "marginPercentage": { "type": "number", "description": "Margin percentage relative to sale price or invested capital" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" }
      },
      "required": ["userId", "make", "model", "year", "mileage", "purchasePrice", "status"]
    },
    "RepairTask": {
      "title": "RepairTask",
      "description": "Specific repair or maintenance task assigned to a vehicle with parts and labor breakdown.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique task ID" },
        "vehicleId": { "type": "string", "description": "ID of the parent vehicle" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "title": { "type": "string", "maxLength": 160, "description": "Task description or common preset name" },
        "status": {
          "type": "string",
          "enum": ["todo", "in_progress", "done"],
          "description": "Task completion state"
        },
        "partsCost": { "type": "number", "description": "Cost of parts in Euros" },
        "laborCost": { "type": "number", "description": "Cost of outsourced or internal labor in Euros" },
        "totalCost": { "type": "number", "description": "partsCost + laborCost" },
        "categoryPreset": { "type": "string", "description": "Preset key if chosen from common templates" },
        "notes": { "type": "string", "maxLength": 500, "description": "Optional notes or mechanic remarks" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" }
      },
      "required": ["vehicleId", "userId", "title", "status", "partsCost", "laborCost"]
    },
    "GeneralExpense": {
      "title": "GeneralExpense",
      "description": "Non-repair financial expense associated with a vehicle (e.g. transport, CT, detailing, admin).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique expense ID" },
        "vehicleId": { "type": "string", "description": "ID of the parent vehicle" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Category identifier (built-in or custom slug from system_config/expenses)"
        },
        "description": { "type": "string", "maxLength": 200, "description": "Detailed description of expense" },
        "amount": { "type": "number", "description": "Expense amount in Euros" },
        "date": { "type": "string", "description": "Date incurred (YYYY-MM-DD)" },
        "receiptUrl": { "type": "string", "description": "Optional attached receipt link or file name" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" }
      },
      "required": ["vehicleId", "userId", "category", "description", "amount", "date"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered garage account profile with RBAC role and subscription plan limits.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "description": "Firebase Auth UID" },
        "email": { "type": "string", "maxLength": 160, "description": "Account email" },
        "displayName": { "type": "string", "maxLength": 100, "description": "Display name" },
        "garageName": { "type": "string", "maxLength": 120, "description": "Primary garage name" },
        "profileType": { "type": "string", "enum": ["particulier", "micro_entrepreneur"], "description": "Active application profile type" },
        "role": { "type": "string", "enum": ["user", "superadmin"], "description": "RBAC role" },
        "planId": { "type": "string", "enum": ["starter", "pro", "enterprise"], "description": "Subscription plan" },
        "plan": { "type": "string", "enum": ["starter", "pro", "enterprise"], "description": "Subscription plan alias" },
        "subscriptionTier": { "type": "string", "enum": ["starter", "pro", "enterprise"], "description": "Subscription tier alias" },
        "billingCycle": { "type": "string", "enum": ["monthly", "annual"], "description": "Billing cycle (monthly or annual)" },
        "vehicleLimit": { "type": "number", "description": "Maximum allowed vehicles" },
        "activeVehiclesCount": { "type": "number", "description": "Current active vehicles count" },
        "subscriptionStatus": { "type": "string", "enum": ["active", "trial", "past_due", "canceled"], "description": "Billing status" },
        "mrrAmount": { "type": "number", "description": "Monthly recurring revenue in EUR" },
        "lastPaymentDate": { "type": "string", "maxLength": 50, "description": "Last payment date" },
        "nextRenewalDate": { "type": "string", "maxLength": 50, "description": "Next billing renewal date" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" }
      },
      "required": ["uid", "email", "role", "planId", "vehicleLimit", "subscriptionStatus"]
    },
    "SystemConfig": {
      "title": "SystemConfig",
      "description": "Global platform design, theme variables, default layout, and Cerfa configuration.",
      "type": "object",
      "properties": {
        "primaryAccentColor": { "type": "string", "maxLength": 20, "description": "Hex color for primary accent" },
        "cardBorderRadius": { "type": "string", "enum": ["6px", "12px", "16px", "24px"], "description": "Global card border radius" },
        "buttonBorderRadius": { "type": "string", "enum": ["6px", "10px", "12px", "16px"], "description": "Global button border radius" },
        "cardPadding": { "type": "string", "enum": ["compact", "comfortable", "spacious"], "description": "Global card internal padding density" },
        "sectionGap": { "type": "string", "enum": ["16px", "24px", "32px"], "description": "Global section vertical spacing" },
        "defaultInventoryViewMode": { "type": "string", "enum": ["grid", "list"], "description": "Default inventory view" },
        "layoutMode": { "type": "string", "enum": ["classic", "sidebar"], "description": "Global default application layout mode" },
        "cerfaAdjustments": { "type": "object", "description": "Global Cerfa 15776*02 alignment adjustments" },
        "lightPalette": { "type": "object", "description": "Custom base and section-level color palette tokens for Light theme (header, cards, vehicle detail, receipt, tables, modals)" },
        "darkPalette": { "type": "object", "description": "Custom base and section-level color palette tokens for Dark theme (header, cards, vehicle detail, receipt, tables, modals)" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" },
        "updatedBy": { "type": "string", "maxLength": 128, "description": "SuperAdmin UID" }
      },
      "required": ["primaryAccentColor", "cardBorderRadius", "defaultInventoryViewMode"]
    },
    "UiCustomization": {
      "title": "UiCustomization",
      "description": "Global UI copywriting overrides (with optional text colors) and layout density configuration managed by SuperAdmin.",
      "type": "object",
      "properties": {
        "overrides": { "type": "object", "description": "Dictionary of localization key overrides (fr/ru/color)" },
        "layout": { "type": "object", "description": "Layout radius, padding, and spacing design tokens" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" },
        "updatedBy": { "type": "string", "maxLength": 128, "description": "SuperAdmin UID" }
      }
    },
    "GarageWorkspace": {
      "title": "GarageWorkspace",
      "description": "Independent garage workspace with legal entity type and tax regime settings.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Garage workspace ID" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "name": { "type": "string", "maxLength": 120, "description": "Garage or owner display name" },
        "profileType": { "type": "string", "enum": ["particulier", "micro_entrepreneur"], "description": "User profile type" },
        "entityType": { "type": "string", "enum": ["morale", "physique"], "description": "Legal status" },
        "legalStatus": { "type": "string", "enum": ["particulier", "micro_entreprise", "sarl", "sas", "eurl", "sasu", "ei", "other"], "description": "Detailed French legal status" },
        "city": { "type": "string", "maxLength": 100, "description": "City" },
        "siret": { "type": "string", "maxLength": 20, "description": "SIRET number for companies" },
        "taxRegime": { "type": "string", "enum": ["sarl", "sas", "micro", "custom", "none"], "description": "Tax regime for P&L" },
        "taxRatePercent": { "type": "number", "description": "Default tax rate percentage" },
        "frenchTaxConfig": { "type": "object", "description": "French tax rules configuration (URSSAF, VL, IS brackets, VAT, effective dates)" },
        "particulierProfile": { "type": "object", "description": "Independent profile details (name, address, phone, email) for Particulier status" },
        "proProfile": { "type": "object", "description": "Independent profile details (company name, SIRET, address, phone, email) for Micro-entrepreneur status" },
        "planId": { "type": "string", "enum": ["starter", "pro", "enterprise"], "description": "Active workspace subscription plan" },
        "plan": { "type": "string", "enum": ["starter", "pro", "enterprise"], "description": "Active workspace subscription plan alias" },
        "subscriptionTier": { "type": "string", "enum": ["starter", "pro", "enterprise"], "description": "Active workspace subscription tier" },
        "billingCycle": { "type": "string", "enum": ["monthly", "annual"], "description": "Billing cycle" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" }
      },
      "required": ["userId", "name", "entityType"]
    },
    "GarageSettings": {
      "title": "GarageSettings",
      "description": "Scoped garage settings including Cerfa profile, TVA mention, layout preference, and French tax configuration.",
      "type": "object",
      "properties": {
        "garageId": { "type": "string", "description": "Target garage ID" },
        "profileType": { "type": "string", "enum": ["particulier", "micro_entrepreneur"], "description": "User profile type" },
        "entityType": { "type": "string", "enum": ["morale", "physique"], "description": "Legal entity type" },
        "legalStatus": { "type": "string", "enum": ["particulier", "micro_entreprise", "sarl", "sas", "eurl", "sasu", "ei", "other"], "description": "Detailed French legal status" },
        "name": { "type": "string", "maxLength": 120, "description": "Garage name" },
        "taxRegime": { "type": "string", "enum": ["sarl", "sas", "micro", "custom", "none"], "description": "Tax regime" },
        "taxRatePercent": { "type": "number", "description": "Tax rate percentage" },
        "currency": { "type": "string", "enum": ["EUR", "USD", "CHF", "GBP"], "description": "Currency" },
        "layoutMode": { "type": "string", "enum": ["global", "classic", "sidebar"], "description": "User layout preference" },
        "frenchTaxConfig": { "type": "object", "description": "Structured French tax configuration (Micro URSSAF/VL, SARL/SAS progressive IS, VAT)" },
        "particulierProfile": { "type": "object", "description": "Independent profile details for Particulier status" },
        "proProfile": { "type": "object", "description": "Independent profile details for Micro-entrepreneur status" },
        "isCalculationHistory": { "type": "array", "description": "Recorded annual corporate IS calculation history" },
        "taxAuditHistory": { "type": "array", "description": "Audit log of tax settings modifications" }
      },
      "required": ["name"]
    },
    "SuperAdminTaxDefaults": {
      "title": "SuperAdminTaxDefaults",
      "description": "Platform-wide default French tax configuration managed by SuperAdmin.",
      "type": "object",
      "properties": {
        "config": { "type": "object", "description": "Default FrenchTaxConfiguration template" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" },
        "updatedBy": { "type": "string", "maxLength": 128, "description": "SuperAdmin UID" }
      },
      "required": ["config"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Vehicle or service supplier (private seller, dealership, auction, parts supplier, workshop, transport company).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique supplier ID" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "garageId": { "type": "string", "maxLength": 128, "description": "Scoped garage workspace ID" },
        "name": { "type": "string", "maxLength": 120, "description": "Supplier name or company" },
        "type": {
          "type": "string",
          "enum": ["private_seller", "dealership", "auction", "parts_supplier", "workshop", "transport_company"],
          "description": "Supplier channel category"
        },
        "contactPerson": { "type": "string", "maxLength": 120, "description": "Contact person name" },
        "phone": { "type": "string", "maxLength": 40, "description": "Phone number" },
        "email": { "type": "string", "maxLength": 160, "description": "Contact email" },
        "city": { "type": "string", "maxLength": 100, "description": "City" },
        "address": { "type": "string", "maxLength": 240, "description": "Street address" },
        "siret": { "type": "string", "maxLength": 30, "description": "Company SIRET / Tax ID" },
        "notes": { "type": "string", "maxLength": 1000, "description": "Notes" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" }
      },
      "required": ["userId", "name", "type"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "Purchase transaction for a vehicle, parts, repair service, or transport linked to a supplier.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique purchase ID" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "garageId": { "type": "string", "maxLength": 128, "description": "Scoped garage workspace ID" },
        "supplierId": { "type": "string", "maxLength": 128, "description": "Supplier document ID" },
        "supplierName": { "type": "string", "maxLength": 120, "description": "Supplier display name" },
        "supplierType": {
          "type": "string",
          "enum": ["private_seller", "dealership", "auction", "parts_supplier", "workshop", "transport_company"],
          "description": "Supplier channel type"
        },
        "vehicleId": { "type": "string", "maxLength": 128, "description": "Optional linked vehicle ID" },
        "vehicleLabel": { "type": "string", "maxLength": 160, "description": "Linked vehicle make/model/plate" },
        "category": {
          "type": "string",
          "enum": ["vehicle", "parts", "repair", "transport", "other"],
          "description": "Purchase category"
        },
        "description": { "type": "string", "maxLength": 240, "description": "Item or vehicle purchased" },
        "amount": { "type": "number", "description": "Purchase price in EUR" },
        "date": { "type": "string", "maxLength": 30, "description": "Purchase date (YYYY-MM-DD)" },
        "paymentMethod": {
          "type": "string",
          "enum": ["bank_transfer", "card", "cash", "check", "financing", "other"],
          "description": "Payment method used"
        },
        "invoiceNumber": { "type": "string", "maxLength": 80, "description": "Invoice or receipt reference" },
        "invoiceProofName": { "type": "string", "maxLength": 160, "description": "Attached invoice filename" },
        "invoiceProofUrl": { "type": "string", "description": "Attached invoice URL or data URI" },
        "vehicleDocuments": { "type": "array", "description": "Attached vehicle documents (max 20)" },
        "notes": { "type": "string", "maxLength": 1000, "description": "Additional purchase notes" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" }
      },
      "required": ["userId", "supplierId", "supplierName", "supplierType", "category", "description", "amount", "date", "paymentMethod", "vehicleDocuments"]
    },
    "GarageDocument": {
      "title": "GarageDocument",
      "description": "Stored PDF or image document bound to a vehicle or client across 10 automotive categories.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique document ID" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "garageId": { "type": "string", "maxLength": 128, "description": "Scoped garage workspace ID" },
        "title": { "type": "string", "maxLength": 160, "description": "Document display title" },
        "category": {
          "type": "string",
          "enum": [
            "carte_grise",
            "certificat_cession",
            "controle_technique",
            "facture_achat",
            "facture_reparation",
            "facture_vente",
            "photos_vehicule",
            "contrats",
            "justificatif_paiement",
            "documents_administratifs"
          ],
          "description": "Document category"
        },
        "bindingType": {
          "type": "string",
          "enum": ["vehicle", "client"],
          "description": "Primary entity binding"
        },
        "vehicleId": { "type": "string", "maxLength": 128, "description": "Linked vehicle ID" },
        "vehicleLabel": { "type": "string", "maxLength": 160, "description": "Linked vehicle summary label" },
        "clientName": { "type": "string", "maxLength": 140, "description": "Linked client full name" },
        "clientEmail": { "type": "string", "maxLength": 160, "description": "Linked client email" },
        "clientPhone": { "type": "string", "maxLength": 40, "description": "Linked client phone" },
        "fileName": { "type": "string", "maxLength": 200, "description": "Original file name" },
        "mimeType": { "type": "string", "maxLength": 100, "description": "MIME type (application/pdf or image/*)" },
        "fileSize": { "type": "number", "description": "File size in bytes" },
        "fileUrl": { "type": "string", "maxLength": 900000, "description": "Data URI or stored file URL" },
        "documentDate": { "type": "string", "maxLength": 30, "description": "Document date (YYYY-MM-DD)" },
        "notes": { "type": "string", "maxLength": 1000, "description": "Optional notes" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" }
      },
      "required": ["userId", "title", "category", "bindingType", "fileName", "mimeType", "fileSize", "fileUrl", "documentDate"]
    },
    "DocumentHistoryEvent": {
      "title": "DocumentHistoryEvent",
      "description": "Audit log entry tracking document uploads, updates, downloads, and deletions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Event ID" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "garageId": { "type": "string", "maxLength": 128, "description": "Scoped garage workspace ID" },
        "documentId": { "type": "string", "maxLength": 128, "description": "Target document ID" },
        "documentTitle": { "type": "string", "maxLength": 160, "description": "Target document title" },
        "category": {
          "type": "string",
          "enum": [
            "carte_grise",
            "certificat_cession",
            "controle_technique",
            "facture_achat",
            "facture_reparation",
            "facture_vente",
            "photos_vehicule",
            "contrats",
            "justificatif_paiement",
            "documents_administratifs"
          ],
          "description": "Document category"
        },
        "action": {
          "type": "string",
          "enum": ["uploaded", "updated", "downloaded", "linked", "deleted"],
          "description": "Action recorded"
        },
        "timestamp": { "type": "string", "maxLength": 40, "description": "ISO event timestamp" },
        "actorEmail": { "type": "string", "maxLength": 160, "description": "Actor email if available" },
        "vehicleId": { "type": "string", "maxLength": 128, "description": "Linked vehicle ID" },
        "vehicleLabel": { "type": "string", "maxLength": 160, "description": "Linked vehicle label" },
        "clientName": { "type": "string", "maxLength": 140, "description": "Linked client name" },
        "details": { "type": "string", "maxLength": 300, "description": "Optional action details" }
      },
      "required": ["userId", "documentId", "documentTitle", "category", "action", "timestamp"]
    },
    "UserActivityLog": {
      "title": "UserActivityLog",
      "description": "Audit log of user actions across exports, backups, vehicles, suppliers, documents, and settings.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Log entry ID" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "garageId": { "type": "string", "maxLength": 128, "description": "Scoped garage workspace ID" },
        "actorEmail": { "type": "string", "maxLength": 160, "description": "User email or identifier" },
        "action": {
          "type": "string",
          "enum": [
            "export_csv",
            "export_excel",
            "export_pdf",
            "export_facturx",
            "backup_created",
            "backup_restored",
            "vehicle_created",
            "vehicle_updated",
            "vehicle_sold",
            "vehicle_deleted",
            "supplier_created",
            "purchase_created",
            "document_uploaded",
            "settings_updated",
            "tax_settings_updated",
            "is_calculation_recorded",
            "auth_login"
          ],
          "description": "Recorded action type"
        },
        "entityType": { "type": "string", "maxLength": 40, "description": "Target entity type" },
        "entityId": { "type": "string", "maxLength": 128, "description": "Target entity ID" },
        "targetLabel": { "type": "string", "maxLength": 200, "description": "Human-readable target label" },
        "details": { "type": "string", "maxLength": 500, "description": "Additional action details" },
        "timestamp": { "type": "string", "maxLength": 50, "description": "ISO timestamp" }
      },
      "required": ["userId", "actorEmail", "action", "targetLabel", "timestamp"]
    },
    "ChangeLogEntry": {
      "title": "ChangeLogEntry",
      "description": "Structured entity change log recording field-level before/after diffs.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Change log entry ID" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "garageId": { "type": "string", "maxLength": 128, "description": "Scoped garage workspace ID" },
        "actorEmail": { "type": "string", "maxLength": 160, "description": "Actor email" },
        "operation": {
          "type": "string",
          "enum": ["create", "update", "delete", "restore"],
          "description": "Mutation operation"
        },
        "entityType": {
          "type": "string",
          "enum": ["vehicle", "repair", "expense", "supplier", "purchase", "document", "settings", "backup"],
          "description": "Target entity category"
        },
        "entityId": { "type": "string", "maxLength": 128, "description": "Target entity ID" },
        "entityLabel": { "type": "string", "maxLength": 200, "description": "Entity display label" },
        "changes": {
          "type": "array",
          "description": "Field-level diff records",
          "items": {
            "type": "object",
            "properties": {
              "field": { "type": "string" },
              "oldValue": { "type": "string" },
              "newValue": { "type": "string" }
            }
          }
        },
        "timestamp": { "type": "string", "maxLength": 50, "description": "ISO timestamp" }
      },
      "required": ["userId", "actorEmail", "operation", "entityType", "entityId", "entityLabel", "changes", "timestamp"]
    },
    "BackupSnapshotRecord": {
      "title": "BackupSnapshotRecord",
      "description": "Named garage backup restore point metadata and bounded JSON snapshot.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Snapshot ID" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "garageId": { "type": "string", "maxLength": 128, "description": "Scoped garage workspace ID" },
        "label": { "type": "string", "maxLength": 160, "description": "User-facing restore point label" },
        "actorEmail": { "type": "string", "maxLength": 160, "description": "Creator email" },
        "createdAt": { "type": "string", "maxLength": 50, "description": "ISO creation timestamp" },
        "sizeBytes": { "type": "number", "description": "Payload size in bytes" },
        "counts": {
          "type": "object",
          "properties": {
            "vehicles": { "type": "number" },
            "repairs": { "type": "number" },
            "expenses": { "type": "number" },
            "suppliers": { "type": "number" },
            "purchases": { "type": "number" },
            "documents": { "type": "number" }
          }
        },
        "payloadJson": { "type": "string", "maxLength": 850000, "description": "Serialized backup JSON payload" }
      },
      "required": ["userId", "label", "actorEmail", "createdAt", "sizeBytes", "counts"]
    },
    "CerfaTemplatesCalibration": {
      "title": "CerfaTemplatesCalibration",
      "description": "Global PDF field calibration coordinates (x, y, font size, stepX, offsets) for Cerfa 15776*02.",
      "type": "object",
      "properties": {
        "cerfa_15776_02": { "type": "object", "description": "Offsets and full section coordinate tree for Cerfa 15776*02" },
        "updatedAtIso": { "type": "string", "maxLength": 50, "description": "ISO timestamp of last calibration update" },
        "updatedBy": { "type": "string", "maxLength": 128, "description": "SuperAdmin UID" },
        "updatedAt": { "type": "string", "description": "Firestore server timestamp" }
      },
      "required": ["cerfa_15776_02"]
    },
    "FeatureFlagsConfig": {
      "title": "FeatureFlagsConfig",
      "description": "Global platform module feature flags managed by SuperAdmin and enforced across all users.",
      "type": "object",
      "properties": {
        "cerfaGenerator": { "type": "boolean", "description": "Enable Cerfa 15776*02 generator" },
        "pnlCalculator": { "type": "boolean", "description": "Enable real-time P&L margin calculator" },
        "expenseAnalytics": { "type": "boolean", "description": "Enable Analytics & P&L charts module" },
        "multiGarage": { "type": "boolean", "description": "Enable multi-garage workspaces and switcher" },
        "repairChecklist": { "type": "boolean", "description": "Enable repair tasks checklist" },
        "suppliersModule": { "type": "boolean", "description": "Enable Suppliers & Purchases module" },
        "documentsModule": { "type": "boolean", "description": "Enable Documents Vault module" },
        "exportsBackup": { "type": "boolean", "description": "Enable Exports & Backup module" },
        "updatedAtIso": { "type": "string", "maxLength": 50, "description": "ISO timestamp of last update" },
        "updatedBy": { "type": "string", "maxLength": 128, "description": "SuperAdmin UID" },
        "updatedAt": { "type": "string", "description": "Firestore server timestamp" }
      }
    },
    "SubscriptionPlansConfig": {
      "title": "SubscriptionPlansConfig",
      "description": "Global platform SaaS subscription plan tiers managed by SuperAdmin.",
      "type": "object",
      "properties": {
        "plans": { "type": "array", "description": "List of subscription plan objects" },
        "updatedAtIso": { "type": "string", "maxLength": 50, "description": "ISO timestamp of last update" },
        "updatedBy": { "type": "string", "maxLength": 128, "description": "SuperAdmin UID" },
        "updatedAt": { "type": "string", "description": "Firestore server timestamp" }
      },
      "required": ["plans"]
    }
  },
  "firestore": {
    "/vehicles/{vehicleId}": {
      "schema": { "$ref": "#/entities/Vehicle" },
      "description": "Top-level collection storing vehicle records owned by users."
    },
    "/vehicles/{vehicleId}/repairs/{repairId}": {
      "schema": { "$ref": "#/entities/RepairTask" },
      "description": "Sub-collection of repair tasks and to-do maintenance items for a vehicle."
    },
    "/vehicles/{vehicleId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/GeneralExpense" },
      "description": "Sub-collection of general non-repair financial expenses for a vehicle."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles storing RBAC role and subscription plan limits."
    },
    "/system_config/{configId}": {
      "schema": { "$ref": "#/entities/SystemConfig" },
      "description": "Global platform theme and template configuration."
    },
    "/garages/{garageId}": {
      "schema": { "$ref": "#/entities/GarageWorkspace" },
      "description": "Garage workspaces owned by authenticated users."
    },
    "/settings/branding": {
      "schema": { "$ref": "#/entities/SystemConfig" },
      "description": "Global branding and dual-theme color palette document."
    },
    "/settings/ui_customization": {
      "schema": { "$ref": "#/entities/UiCustomization" },
      "description": "Global UI copywriting overrides and component layout configuration."
    },
    "/settings/copywriting": {
      "schema": { "$ref": "#/entities/UiCustomization" },
      "description": "Global copywriting label overrides synchronized for all workspaces."
    },
    "/settings/tax_defaults": {
      "schema": { "$ref": "#/entities/SuperAdminTaxDefaults" },
      "description": "Platform-wide default French tax configuration managed by SuperAdmin."
    },
    "/settings/{settingsId}": {
      "schema": { "$ref": "#/entities/GarageSettings" },
      "description": "Per-user per-garage settings documents."
    },
    "/suppliers/{supplierId}": {
      "schema": { "$ref": "#/entities/Supplier" },
      "description": "Suppliers directory owned by authenticated garage users."
    },
    "/purchases/{purchaseId}": {
      "schema": { "$ref": "#/entities/Purchase" },
      "description": "Purchase transactions and sourcing records linked to suppliers and vehicles."
    },
    "/garage_documents/{documentId}": {
      "schema": { "$ref": "#/entities/GarageDocument" },
      "description": "Central document vault storing PDFs and images bound to vehicles and clients."
    },
    "/document_history/{eventId}": {
      "schema": { "$ref": "#/entities/DocumentHistoryEvent" },
      "description": "Audit log of document uploads, updates, downloads, and deletions."
    },
    "/user_activity_logs/{logId}": {
      "schema": { "$ref": "#/entities/UserActivityLog" },
      "description": "Audit trail of user actions and export/backup operations."
    },
    "/change_logs/{logId}": {
      "schema": { "$ref": "#/entities/ChangeLogEntry" },
      "description": "Structured entity change log recording field-level before/after diffs."
    },
    "/backup_snapshots/{snapshotId}": {
      "schema": { "$ref": "#/entities/BackupSnapshotRecord" },
      "description": "Named garage backup restore points."
    },
    "/platform_settings/cerfa_templates": {
      "schema": { "$ref": "#/entities/CerfaTemplatesCalibration" },
      "description": "Global platform Cerfa PDF field calibration coordinates managed by SuperAdmin."
    },
    "/platform_settings/feature_flags": {
      "schema": { "$ref": "#/entities/FeatureFlagsConfig" },
      "description": "Global platform feature flags managed by SuperAdmin and synced in real time across all users."
    },
    "/platform_settings/subscription_plans": {
      "schema": { "$ref": "#/entities/SubscriptionPlansConfig" },
      "description": "Global platform SaaS subscription plans synced between SuperAdmin and user settings."
    }
  }
}
