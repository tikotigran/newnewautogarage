rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'blackproduction999@gmail.com' && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin')
      );
    }

    function isValidVehicle(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.make is string && data.make.size() > 0 && data.make.size() <= 80 &&
             data.model is string && data.model.size() > 0 && data.model.size() <= 80 &&
             data.year is number && data.year >= 1900 && data.year <= 2100 &&
             data.mileage is number && data.mileage >= 0 &&
             data.purchasePrice is number && data.purchasePrice >= 0 &&
             data.status in ['preparation', 'repair', 'for_sale', 'sold'] &&
             (!('registrationNumber' in data) || (data.registrationNumber is string && data.registrationNumber.size() <= 30)) &&
             (!('totalExpenses' in data) || (data.totalExpenses is number && data.totalExpenses >= 0)) &&
             (!('totalInvested' in data) || (data.totalInvested is number && data.totalInvested >= 0));
    }

    function isValidRepairTask(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.vehicleId is string &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 160 &&
             data.status in ['todo', 'in_progress', 'done'] &&
             data.partsCost is number && data.partsCost >= 0 &&
             data.laborCost is number && data.laborCost >= 0;
    }

    function isValidGeneralExpense(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.vehicleId is string &&
             data.category in ['transport', 'fuel', 'controle_technique', 'detailing', 'admin', 'insurance', 'other'] &&
             data.description is string && data.description.size() > 0 && data.description.size() <= 200 &&
             data.amount is number && data.amount >= 0 &&
             data.date is string;
    }

    function isValidUserProfile(data, userId) {
      return data.uid is string &&
             data.uid == userId &&
             data.email is string && data.email.size() <= 160 &&
             (!('profileType' in data) || data.profileType in ['particulier', 'micro_entrepreneur']) &&
             data.role in ['user', 'superadmin'] &&
             data.planId in ['starter', 'pro', 'enterprise'] &&
             data.vehicleLimit is number && data.vehicleLimit >= 0 &&
             data.subscriptionStatus in ['active', 'trial', 'past_due', 'canceled'];
    }

    function isValidSystemConfig(data) {
      return data.primaryAccentColor is string && data.primaryAccentColor.size() <= 20 &&
             data.cardBorderRadius in ['6px', '12px', '16px', '24px'] &&
             (!('buttonBorderRadius' in data) || data.buttonBorderRadius in ['6px', '10px', '12px', '16px']) &&
             (!('cardPadding' in data) || data.cardPadding in ['compact', 'comfortable', 'spacious']) &&
             (!('sectionGap' in data) || data.sectionGap in ['16px', '24px', '32px']) &&
             data.defaultInventoryViewMode in ['grid', 'list'];
    }

    function isValidUiCustomization(data) {
      return (!('overrides' in data) || data.overrides is map) &&
             (!('layout' in data) || data.layout is map);
    }

    function isValidCerfaTemplatesCalibration(data) {
      return data.keys().hasOnly(['cerfa_15776_02', 'cerfa_13750_07', 'declaration_achat', 'updatedAtIso', 'updatedBy', 'updatedAt']) &&
             ('cerfa_15776_02' in data) && data.cerfa_15776_02 is map &&
             ('offsets' in data.cerfa_15776_02) && data.cerfa_15776_02.offsets is map &&
             ('config' in data.cerfa_15776_02) && data.cerfa_15776_02.config is map &&
             ('cerfa_13750_07' in data) && data.cerfa_13750_07 is map &&
             ('offsets' in data.cerfa_13750_07) && data.cerfa_13750_07.offsets is map &&
             ('fields' in data.cerfa_13750_07) && data.cerfa_13750_07.fields is map &&
             ('declaration_achat' in data) && data.declaration_achat is map &&
             ('offsets' in data.declaration_achat) && data.declaration_achat.offsets is map &&
             ('fields' in data.declaration_achat) && data.declaration_achat.fields is map &&
             (!('updatedAtIso' in data) || (data.updatedAtIso is string && data.updatedAtIso.size() <= 50)) &&
             (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128));
    }

    function isValidGarageWorkspace(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.entityType in ['morale', 'physique'] &&
             (!('profileType' in data) || data.profileType in ['particulier', 'micro_entrepreneur']) &&
             (!('taxRegime' in data) || data.taxRegime in ['sarl', 'sas', 'micro', 'custom', 'none']) &&
             (!('taxRatePercent' in data) || (data.taxRatePercent is number && data.taxRatePercent >= 0 && data.taxRatePercent <= 100));
    }

    function isValidGarageSettings(data) {
      return data.name is string && data.name.size() <= 120 &&
             (!('entityType' in data) || data.entityType in ['morale', 'physique']) &&
             (!('profileType' in data) || data.profileType in ['particulier', 'micro_entrepreneur']) &&
             (!('taxRegime' in data) || data.taxRegime in ['sarl', 'sas', 'micro', 'custom', 'none']) &&
             (!('taxRatePercent' in data) || (data.taxRatePercent is number && data.taxRatePercent >= 0 && data.taxRatePercent <= 100));
    }

    function isValidSupplier(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.type in ['private_seller', 'dealership', 'auction', 'parts_supplier', 'workshop', 'transport_company'] &&
             (!('garageId' in data) || (data.garageId is string && data.garageId.size() <= 128)) &&
             (!('contactPerson' in data) || (data.contactPerson is string && data.contactPerson.size() <= 120)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
             (!('city' in data) || (data.city is string && data.city.size() <= 100)) &&
             (!('address' in data) || (data.address is string && data.address.size() <= 240)) &&
             (!('siret' in data) || (data.siret is string && data.siret.size() <= 30)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000));
    }

    function isValidPurchase(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.supplierId is string && data.supplierId.size() > 0 && data.supplierId.size() <= 128 &&
             data.supplierName is string && data.supplierName.size() > 0 && data.supplierName.size() <= 120 &&
             data.supplierType in ['private_seller', 'dealership', 'auction', 'parts_supplier', 'workshop', 'transport_company'] &&
             data.category in ['vehicle', 'parts', 'repair', 'transport', 'other'] &&
             data.description is string && data.description.size() > 0 && data.description.size() <= 240 &&
             data.amount is number && data.amount >= 0 &&
             data.date is string && data.date.size() > 0 && data.date.size() <= 30 &&
             data.paymentMethod in ['bank_transfer', 'card', 'cash', 'check', 'financing', 'other'] &&
             data.vehicleDocuments is list && data.vehicleDocuments.size() <= 20 &&
             (!('garageId' in data) || (data.garageId is string && data.garageId.size() <= 128)) &&
             (!('vehicleId' in data) || (data.vehicleId is string && data.vehicleId.size() <= 128)) &&
             (!('vehicleLabel' in data) || (data.vehicleLabel is string && data.vehicleLabel.size() <= 160)) &&
             (!('invoiceNumber' in data) || (data.invoiceNumber is string && data.invoiceNumber.size() <= 80)) &&
             (!('invoiceProofName' in data) || (data.invoiceProofName is string && data.invoiceProofName.size() <= 160)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000));
    }

    function isValidGarageDocument(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 160 &&
             data.category in [
               'carte_grise',
               'certificat_cession',
               'controle_technique',
               'facture_achat',
               'facture_reparation',
               'facture_vente',
               'photos_vehicule',
               'contrats',
               'justificatif_paiement',
               'documents_administratifs'
             ] &&
             data.bindingType in ['vehicle', 'client'] &&
             data.fileName is string && data.fileName.size() > 0 && data.fileName.size() <= 200 &&
             data.mimeType is string && data.mimeType.size() > 0 && data.mimeType.size() <= 100 &&
             data.fileSize is number && data.fileSize >= 0 &&
             data.fileUrl is string && data.fileUrl.size() > 0 &&
             data.documentDate is string && data.documentDate.size() > 0 && data.documentDate.size() <= 30 &&
             (!('garageId' in data) || (data.garageId is string && data.garageId.size() <= 128)) &&
             (!('vehicleId' in data) || (data.vehicleId is string && data.vehicleId.size() <= 128)) &&
             (!('vehicleLabel' in data) || (data.vehicleLabel is string && data.vehicleLabel.size() <= 160)) &&
             (!('clientName' in data) || (data.clientName is string && data.clientName.size() <= 140)) &&
             (!('clientEmail' in data) || (data.clientEmail is string && data.clientEmail.size() <= 160)) &&
             (!('clientPhone' in data) || (data.clientPhone is string && data.clientPhone.size() <= 40)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000));
    }

    function isValidDocumentHistoryEvent(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.documentId is string && data.documentId.size() > 0 && data.documentId.size() <= 128 &&
             data.documentTitle is string && data.documentTitle.size() > 0 && data.documentTitle.size() <= 160 &&
             data.category in [
               'carte_grise',
               'certificat_cession',
               'controle_technique',
               'facture_achat',
               'facture_reparation',
               'facture_vente',
               'photos_vehicule',
               'contrats',
               'justificatif_paiement',
               'documents_administratifs'
             ] &&
             data.action in ['uploaded', 'updated', 'downloaded', 'linked', 'deleted'] &&
             data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() <= 50 &&
             (!('garageId' in data) || (data.garageId is string && data.garageId.size() <= 128)) &&
             (!('actorEmail' in data) || (data.actorEmail is string && data.actorEmail.size() <= 160)) &&
             (!('vehicleId' in data) || (data.vehicleId is string && data.vehicleId.size() <= 128)) &&
             (!('vehicleLabel' in data) || (data.vehicleLabel is string && data.vehicleLabel.size() <= 160)) &&
             (!('clientName' in data) || (data.clientName is string && data.clientName.size() <= 140)) &&
             (!('details' in data) || (data.details is string && data.details.size() <= 300));
    }

    function isValidUserActivityLog(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.actorEmail is string && data.actorEmail.size() > 0 && data.actorEmail.size() <= 160 &&
             data.action in [
               'export_csv',
               'export_excel',
               'export_pdf',
               'export_facturx',
               'backup_created',
               'backup_restored',
               'vehicle_created',
               'vehicle_updated',
               'vehicle_sold',
               'vehicle_deleted',
               'supplier_created',
               'purchase_created',
               'document_uploaded',
               'settings_updated',
               'tax_settings_updated',
               'is_calculation_recorded',
               'auth_login'
             ] &&
             data.targetLabel is string && data.targetLabel.size() > 0 && data.targetLabel.size() <= 200 &&
             data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() <= 50 &&
             (!('garageId' in data) || (data.garageId is string && data.garageId.size() <= 128)) &&
             (!('entityType' in data) || (data.entityType is string && data.entityType.size() <= 40)) &&
             (!('entityId' in data) || (data.entityId is string && data.entityId.size() <= 128)) &&
             (!('details' in data) || (data.details is string && data.details.size() <= 500));
    }

    function isValidChangeLogEntry(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.actorEmail is string && data.actorEmail.size() > 0 && data.actorEmail.size() <= 160 &&
             data.operation in ['create', 'update', 'delete', 'restore'] &&
             data.entityType in ['vehicle', 'repair', 'expense', 'supplier', 'purchase', 'document', 'settings', 'backup'] &&
             data.entityId is string && data.entityId.size() > 0 && data.entityId.size() <= 128 &&
             data.entityLabel is string && data.entityLabel.size() > 0 && data.entityLabel.size() <= 200 &&
             data.changes is list &&
             data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() <= 50 &&
             (!('garageId' in data) || (data.garageId is string && data.garageId.size() <= 128));
    }

    function isValidBackupSnapshot(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.label is string && data.label.size() > 0 && data.label.size() <= 160 &&
             data.actorEmail is string && data.actorEmail.size() > 0 && data.actorEmail.size() <= 160 &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 50 &&
             data.sizeBytes is number && data.sizeBytes >= 0 &&
             data.counts is map &&
             (!('garageId' in data) || (data.garageId is string && data.garageId.size() <= 128)) &&
             (!('payloadJson' in data) || (data.payloadJson is string && data.payloadJson.size() <= 850000));
    }

    // Connection testing endpoint for boot verification
    match /test/connection {
      allow read: if true;
    }

    // User profiles & RBAC
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isSignedIn() && isValidId(userId) &&
                    isValidUserProfile(incoming(), userId) &&
                    ((request.auth.uid == userId && incoming().role == 'user') || isSuperAdmin());
      allow update: if isSignedIn() && isValidId(userId) &&
                    isValidUserProfile(incoming(), userId) && (
                      isSuperAdmin() ||
                      (request.auth.uid == userId &&
                       incoming().role == existing().role &&
                       incoming().planId == existing().planId &&
                       incoming().vehicleLimit == existing().vehicleLimit &&
                       incoming().subscriptionStatus == existing().subscriptionStatus &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'garageName', 'profileType', 'activeVehiclesCount', 'updatedAt']))
                    );
      allow delete: if isSuperAdmin();
    }

    // Global System Config (Theme, Layout, Cerfa, Expenses, Features, Texts)
    match /system_config/{configId} {
      allow get: if true;
      allow list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin() && isValidId(configId) &&
        (configId != 'global' || isValidSystemConfig(incoming()));
    }

    // Garage Workspaces collection
    match /garages/{garageId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isSuperAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() && isValidId(garageId) && isValidGarageWorkspace(incoming());
      allow update: if isSignedIn() && isValidId(garageId) &&
                    (existing().userId == request.auth.uid || isSuperAdmin()) &&
                    incoming().userId == existing().userId &&
                    isValidGarageWorkspace(incoming());
      allow delete: if isSignedIn() && isValidId(garageId) && (existing().userId == request.auth.uid || isSuperAdmin());
    }

    // Global Branding & Theme Tokens (/settings/branding)
    match /settings/branding {
      allow get: if true;
      allow create, update, delete: if isSuperAdmin() && isValidSystemConfig(incoming());
    }

    // Global UI Customization & Copywriting Overrides (/settings/ui_customization, /settings/copywriting)
    match /settings/ui_customization {
      allow get: if true;
      allow create, update, delete: if isSuperAdmin() && isValidUiCustomization(incoming());
    }

    match /settings/copywriting {
      allow get: if true;
      allow create, update, delete: if isSuperAdmin() && isValidUiCustomization(incoming());
    }

    // Platform-wide default French tax rules (/settings/tax_defaults)
    match /settings/tax_defaults {
      allow get: if true;
      allow create, update, delete: if isSuperAdmin() && ('config' in incoming()) && incoming().config is map;
    }

    // Global Cerfa template field calibration coordinates (/platform_settings/cerfa_templates)
    match /platform_settings/cerfa_templates {
      allow get: if true;
      allow create, update: if isSuperAdmin() && isValidCerfaTemplatesCalibration(incoming());
      allow delete: if isSuperAdmin();
    }

    // Scoped Garage Settings collection ({userId}_{garageId})
    match /settings/{settingsId} {
      allow get: if isSignedIn() && isValidId(settingsId) &&
        (settingsId.matches('^' + request.auth.uid + '_.*') || isSuperAdmin());
      allow create, update: if isSignedIn() && isValidId(settingsId) &&
        (settingsId.matches('^' + request.auth.uid + '_.*') || isSuperAdmin()) &&
        isValidGarageSettings(incoming());
      allow delete: if isSignedIn() && isValidId(settingsId) &&
        (settingsId.matches('^' + request.auth.uid + '_.*') || isSuperAdmin());
    }

    // Vehicles collection
    match /vehicles/{vehicleId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isSuperAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() && isValidId(vehicleId) && isValidVehicle(incoming());
      allow update: if isSignedIn() && isValidId(vehicleId) &&
                    (existing().userId == request.auth.uid || isSuperAdmin()) &&
                    incoming().userId == existing().userId &&
                    isValidVehicle(incoming());
      allow delete: if isSignedIn() && isValidId(vehicleId) && (existing().userId == request.auth.uid || isSuperAdmin());

      // Subcollection for vehicle repairs & tasks
      match /repairs/{repairId} {
        allow get, list: if isSignedIn() && (
          get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.userId == request.auth.uid ||
          isSuperAdmin()
        );
        allow create: if isSignedIn() && isValidId(vehicleId) && isValidId(repairId) &&
          get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.userId == request.auth.uid &&
          isValidRepairTask(incoming());
        allow update: if isSignedIn() && isValidId(vehicleId) && isValidId(repairId) &&
          get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.userId == request.auth.uid &&
          existing().userId == request.auth.uid &&
          incoming().userId == request.auth.uid &&
          isValidRepairTask(incoming());
        allow delete: if isSignedIn() && isValidId(vehicleId) && isValidId(repairId) &&
          get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.userId == request.auth.uid &&
          existing().userId == request.auth.uid;
      }

      // Subcollection for vehicle general expenses
      match /expenses/{expenseId} {
        allow get, list: if isSignedIn() && (
          get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.userId == request.auth.uid ||
          isSuperAdmin()
        );
        allow create: if isSignedIn() && isValidId(vehicleId) && isValidId(expenseId) &&
          get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.userId == request.auth.uid &&
          isValidGeneralExpense(incoming());
        allow update: if isSignedIn() && isValidId(vehicleId) && isValidId(expenseId) &&
          get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.userId == request.auth.uid &&
          existing().userId == request.auth.uid &&
          incoming().userId == request.auth.uid &&
          isValidGeneralExpense(incoming());
        allow delete: if isSignedIn() && isValidId(vehicleId) && isValidId(expenseId) &&
          get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.userId == request.auth.uid &&
          existing().userId == request.auth.uid;
      }
    }

    // Suppliers collection
    match /suppliers/{supplierId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isSuperAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() && isValidId(supplierId) && isValidSupplier(incoming());
      allow update: if isSignedIn() && isValidId(supplierId) &&
                    (existing().userId == request.auth.uid || isSuperAdmin()) &&
                    incoming().userId == existing().userId &&
                    isValidSupplier(incoming());
      allow delete: if isSignedIn() && isValidId(supplierId) && (existing().userId == request.auth.uid || isSuperAdmin());
    }

    // Purchases collection
    match /purchases/{purchaseId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isSuperAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() && isValidId(purchaseId) && isValidPurchase(incoming());
      allow update: if isSignedIn() && isValidId(purchaseId) &&
                    (existing().userId == request.auth.uid || isSuperAdmin()) &&
                    incoming().userId == existing().userId &&
                    isValidPurchase(incoming());
      allow delete: if isSignedIn() && isValidId(purchaseId) && (existing().userId == request.auth.uid || isSuperAdmin());
    }

    // Garage Documents vault collection
    match /garage_documents/{documentId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isSuperAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() && isValidId(documentId) && isValidGarageDocument(incoming());
      allow update: if isSignedIn() && isValidId(documentId) &&
                    (existing().userId == request.auth.uid || isSuperAdmin()) &&
                    incoming().userId == existing().userId &&
                    isValidGarageDocument(incoming());
      allow delete: if isSignedIn() && isValidId(documentId) && (existing().userId == request.auth.uid || isSuperAdmin());
    }

    // Document History audit log collection
    match /document_history/{eventId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isSuperAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() && isValidId(eventId) && isValidDocumentHistoryEvent(incoming());
      allow delete: if isSignedIn() && isValidId(eventId) && (existing().userId == request.auth.uid || isSuperAdmin());
    }

    // User Activity Logs collection
    match /user_activity_logs/{logId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isSuperAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() && isValidId(logId) && isValidUserActivityLog(incoming());
      allow delete: if isSignedIn() && isValidId(logId) && (existing().userId == request.auth.uid || isSuperAdmin());
    }

    // Structured Entity Change Logs collection
    match /change_logs/{logId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isSuperAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() && isValidId(logId) && isValidChangeLogEntry(incoming());
      allow delete: if isSignedIn() && isValidId(logId) && (existing().userId == request.auth.uid || isSuperAdmin());
    }

    // Named Garage Backup Snapshots collection
    match /backup_snapshots/{snapshotId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isSuperAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() && isValidId(snapshotId) && isValidBackupSnapshot(incoming());
      allow delete: if isSignedIn() && isValidId(snapshotId) && (existing().userId == request.auth.uid || isSuperAdmin());
    }
  }
}
